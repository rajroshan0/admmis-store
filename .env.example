# ───────── Site ─────────
# Public URL of your deployed site (no trailing slash). Used for eSewa redirects,
# sitemap and auth emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────── Supabase ─────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# SERVER ONLY. Never expose this or prefix it with NEXT_PUBLIC_.
# Used only to mark eSewa payments as paid after signature verification.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ───────── eSewa (ePay v2) ─────────
# Test values below come from eSewa's developer docs (UAT/sandbox).
# For production, replace them with the merchant values eSewa gives you
# and switch the three URLs to the production ones.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
# Production:
# ESEWA_FORM_URL=https://epay.esewa.com.np/api/epay/main/v2/form
# ESEWA_STATUS_URL=https://epay.esewa.com.np/api/epay/transaction/status/

# ───────── Android app download ─────────
# Direct link to the .apk (see README "Android app"). Leave empty to show "coming soon" on /app.
NEXT_PUBLIC_APK_URL=
