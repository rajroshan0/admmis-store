# Same Supabase project as the website (Supabase -> Project Settings -> API).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Where the website runs. The app uses it for placing orders, eSewa payments and the hero photo.
# Testing on a real phone: use your Mac's Wi-Fi address, NOT localhost, e.g. http://192.168.1.23:3000
# Production: https://your-domain.com
EXPO_PUBLIC_API_URL=http://192.168.1.23:3000

# Support contact shown in "Chat with support" (leave empty to hide a button)
# WhatsApp: digits only with country code, e.g. 9779812345678
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_EMAIL=
